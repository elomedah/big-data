---
# Manual fallback: copy only if group_vars/student_ssh_keys.yml does not exist.
# Otherwise append keys to the existing file without replacing its entries.
# Normally students submit the public GitHub form; see ../../access/README.md.
# New usernames use nom.prenom (surname.firstname).
#
# Each student generates their own SSH key locally and sends only the .pub
# content. Never ask students to send their private key.

student_ssh_keys:
  dupont.jean:
    - "ssh-ed25519 AAAA... dupont.jean"
  martin.alice:
    - "ssh-ed25519 AAAA... martin.alice"
