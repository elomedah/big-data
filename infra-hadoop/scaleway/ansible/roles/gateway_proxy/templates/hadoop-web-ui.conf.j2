{% for port in range(4040, 4051) %}
server {
    listen 0.0.0.0:{{ port }};
    server_name _;
    location / {
        proxy_pass http://127.0.0.1:{{ port }};
        proxy_set_header Accept-Encoding "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        sub_filter_once off;
        sub_filter_types text/html text/plain application/json;
        sub_filter 'http://localhost:{{ port }}' 'http://$http_host';
        sub_filter 'localhost:{{ port }}' '$http_host';
    }
}
{% endfor %}

server {
    listen 0.0.0.0:19888;
    server_name _;

    location /cluster/ {
        return 302 $scheme://$host:8088$request_uri;
    }

    location /proxy/ {
        return 302 $scheme://$host:8088$request_uri;
    }

    location / {
        proxy_pass http://{{ hostvars[groups['masters'][0]].private_ip }}:19888;
        proxy_redirect http://master:19888/ http://$http_host/;
        proxy_redirect http://{{ hostvars[groups['masters'][0]].private_ip }}:19888/ http://$http_host/;
        proxy_set_header Accept-Encoding "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Proto $scheme;
        sub_filter_once off;
        sub_filter_types text/html text/plain application/json;
        sub_filter 'http://master:19888' 'http://$http_host';
        sub_filter 'http://{{ hostvars[groups['masters'][0]].private_ip }}:19888' 'http://$http_host';
        sub_filter 'master:19888' '$http_host';
        sub_filter '{{ hostvars[groups['masters'][0]].private_ip }}:19888' '$http_host';
    }
}

