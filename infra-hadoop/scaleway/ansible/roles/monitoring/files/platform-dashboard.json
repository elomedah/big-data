      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platform-prometheus"
          },
          "refId": "A",
          "expr": "sum(probe_success{job=\"services\"})",
          "legendFormat": ""
        }
      ]
    },
