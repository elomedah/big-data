      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "platform-prometheus"
          },
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"node\",node=~\"$node\",fstype!~\"tmpfs|overlay|squashfs|proc|sysfs|devtmpfs\"}",
          "legendFormat": "{{node}} {{mountpoint}}"
        }
      ]
    },
