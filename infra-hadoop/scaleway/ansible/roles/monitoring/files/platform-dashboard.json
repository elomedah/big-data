      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
